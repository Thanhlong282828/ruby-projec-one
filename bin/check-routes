#!/usr/bin/env ruby
# Enforce explicit HTTP routes across the host and every local module.
require "ripper"

Dir.chdir(File.expand_path("..", __dir__))
files = (["config/routes.rb"] + Dir["config/routes/**/*.rb", "modules/*/config/routes.rb", "modules/*/config/routes/**/*.rb"]).sort
forbidden = %w[resource resources namespace]
violations = []

visit = lambda do |node, file|
  next unless node.is_a?(Array)

  token = case node[0]
          when :command, :fcall, :vcall then node[1]
          when :call, :command_call then node[3]
          end
  if token.is_a?(Array) && token[0] == :@ident && forbidden.include?(token[1])
    violations << "#{file}:#{token[2][0]}: replace #{token[1]} with explicit HTTP routes"
  end
  node.each { |child| visit.call(child, file) if child.is_a?(Array) }
end

files.each do |file|
  tree = Ripper.sexp(File.read(file))
  if tree
    visit.call(tree, file)
  else
    violations << "#{file}: invalid Ruby syntax"
  end
end

abort(violations.join("\n")) unless violations.empty?
puts "Explicit route check passed (#{files.length} routing files)."
