<div class="page-heading"><div><div class="eyebrow">ATTENDANCE</div><h1>Lịch công theo phân ca.</h1><p class="subtitle">Đối chiếu theo cấu hình đã lưu; chưa loại trừ ngày nghỉ, chưa chốt công hoặc duyệt tăng ca.</p></div><%= link_to "Danh sách phân ca →",shift_assignments_path %></div>
<div class="panel"><%= form_with url: employee_shift_schedule_path,method: :get do |form| %><div class="form-grid"><div class="field"><%= form.label :employee_id,"Nhân viên" %><%= form.select :employee_id,@data[:options][:employees],{selected: @data[:employee]&.fetch(:id),prompt: "Chọn nhân viên"},required: true %></div><div class="field"><%= form.label :from,"Từ ngày" %><%= form.date_field :from,value: @data[:from],required: true %></div><div class="field"><%= form.label :to,"Đến ngày" %><%= form.date_field :to,value: @data[:to],required: true %></div></div><%= form.submit "Xem lịch công" %><% end %><p class="hint">Tối đa 31 ngày; danh sách chọn tối đa 200 người. Chưa có lượt công không đồng nghĩa vắng mặt.</p></div>
<div class="panel"><table><thead><tr><th>Ngày</th><th>Phân ca nguồn</th><th>Giờ dự kiến</th><th>Phút sau nghỉ</th><th>Trạng thái</th><th>Công nguồn</th></tr></thead><tbody>
<% @data[:rows].each do |row| %><tr><td><%= row[:date] %></td><td><% if row[:assignment_path] %><%= link_to row[:shift_code],row[:assignment_path] %><% else %>—<% end %></td><td><%= row[:start]&.strftime("%d/%m %H:%M") || "—" %> → <%= row[:finish]&.strftime("%d/%m %H:%M") || "—" %></td><td><%= row[:result]&.fetch(:worked_minutes) || "—" %></td><td><%= {"unassigned"=>"Chưa phân ca","conflict"=>"Lịch trùng, cần kiểm tra","restricted"=>"Không có quyền xem công","not_recorded"=>"Chưa có lượt công","incomplete"=>"Thiếu vào/ra","present"=>"Không trễ/sớm","late"=>"Đi trễ","early_leave"=>"Về sớm","late_and_early"=>"Trễ và sớm"}.fetch(row[:status]) %></td><td><% if row[:attendance_path] %><%= link_to "Mở lượt công →",row[:attendance_path] %><% else %>—<% end %></td></tr><% end %></tbody></table><% if @data[:rows].empty? %><div class="empty">Chọn nhân viên và khoảng ngày để xem lịch công.</div><% end %></div>
