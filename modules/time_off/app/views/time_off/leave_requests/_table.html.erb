<table><thead><tr><th>Nhân viên</th><th>Thời gian</th><th>Số ngày</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><% requests.each do |request| %><tr><td><%= request.employee.full_name %></td><td><%= request.starts_on %> → <%= request.ends_on %></td><td><%= request.days %></td><td><span class="badge <%= request.status %>"><%= request.status %></span></td><td><% if request.pending? && policy(request).approve? %><%= button_to "Duyệt", approve_leave_request_path(request), method: :patch %> <%= button_to "Từ chối", reject_leave_request_path(request), method: :patch, class: "danger" %><% else %>—<% end %></td></tr><% end %></tbody></table><% if requests.empty? %><div class="empty">Chưa có đơn nghỉ phép.</div><% end %>
