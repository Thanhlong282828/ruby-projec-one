<div class="page-heading"><div><div class="eyebrow"><%= @employee.employee_code %></div><h1><%= @employee.full_name %></h1><p class="subtitle"><%= @employee.job_title %> • <%= @employee.department.name %></p></div><% if policy(@employee).update? %><%= link_to "Chỉnh sửa hồ sơ", edit_employee_path(@employee), class: "button" %><% end %></div>
<div class="panel"><dl class="details"><% { "Email" => @employee.email, "Ngày vào làm" => @employee.hired_on, "Trạng thái" => @employee.status, "Ngày phép năm" => @employee.annual_leave_days }.each do |label, value| %><div><dt><%= label %></dt><dd><%= value %></dd></div><% end %>
<% if current_user.staff? %><div><dt>Lương cơ bản</dt><dd><%= number_to_currency @employee.salary_cents, unit: "₫", precision: 0 %></dd></div><div><dt>Tài khoản ngân hàng</dt><dd><%= @employee.bank_account.presence || "Chưa cập nhật" %></dd></div><% end %></dl></div>
<% if policy(@employee).destroy? %><%= button_to "Xóa hồ sơ", @employee, method: :delete, class: "danger" %><p class="hint">Chỉ xóa hồ sơ chưa có dữ liệu liên quan. Dùng trạng thái inactive để lưu lịch sử.</p><% end %>
