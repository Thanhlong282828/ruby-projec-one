<div class="page-heading"><div><div class="eyebrow">PAYROLL</div><h1>Bảng lương nội bộ.</h1><p class="subtitle">Chụp lương cơ bản tại thời điểm tạo. Chưa tính thuế, bảo hiểm và làm thêm.</p></div><% if policy(PayRun).create? %><%= link_to "+ Tạo kỳ lương", new_pay_run_path, class: "button" %><% end %></div><%= form_with url: pay_runs_path, method: :get, class: "source-filters" do %><label for="status">Trạng thái</label><%= select_tag :status, options_for_select([["Tất cả", ""], ["Chờ chốt", "draft"], ["Đã chốt", "finalized"]], params[:status]) %><label for="period">Kỳ lương</label><%= month_field_tag :period, params[:period] %><%= submit_tag "Lọc dữ liệu" %><%= link_to "Xóa bộ lọc", pay_runs_path %><% end %>
<div class="panel"><table><thead><tr><th>Kỳ lương</th><th>Trạng thái</th><th>Ngày tạo</th><th></th></tr></thead><tbody><% @runs.each do |run| %><tr><td><%= run.period.strftime("%m / %Y") %></td><td><span class="badge <%= run.status %>"><%= t("erp.statuses.#{run.status}") %></span></td><td><%= run.created_at.to_date %></td><td><%= link_to "Chi tiết →", run %></td></tr><% end %></tbody></table><% if @runs.empty? %><div class="empty">Không có kỳ lương phù hợp với bộ lọc.</div><% end %></div><%= render "shared/pagination", records: @runs %>
