<div class="page-heading"><div><div class="eyebrow">PAYROLL</div><h1>Bảng lương nội bộ.</h1><p class="subtitle">Chụp lương cơ bản tại thời điểm tạo. Chưa tính thuế, bảo hiểm và làm thêm.</p></div><% if policy(PayRun).create? %><%= link_to "+ Tạo kỳ lương", new_pay_run_path, class: "button" %><% end %></div><div class="panel"><table><thead><tr><th>Kỳ lương</th><th>Trạng thái</th><th>Ngày tạo</th><th></th></tr></thead><tbody><% @runs.each do |run| %><tr><td><%= run.period.strftime("%m / %Y") %></td><td><span class="badge <%= run.status %>"><%= run.status %></span></td><td><%= run.created_at.to_date %></td><td><%= link_to "Chi tiết →", run %></td></tr><% end %></tbody></table></div><%= render "shared/pagination", records: @runs %>
