<h1>Tạo kỳ lương.</h1><p class="subtitle">Hệ thống lưu bản chụp lương cơ bản của nhân viên đang làm việc.</p><div class="panel"><%= render "shared/errors", record: @run %><%= form_with model: @run do |f| %><div class="field"><%= f.label :period, "Ngày thuộc kỳ lương" %><%= f.date_field :period, required: true %></div><div class="form-actions"><%= f.submit "Tạo bảng lương nháp" %></div><% end %></div>
