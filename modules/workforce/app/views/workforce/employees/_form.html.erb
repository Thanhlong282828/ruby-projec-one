<%= render "shared/errors", record: @employee %>
<%= form_with model: @employee do |f| %><div class="form-grid">
<% { employee_code: "Mã nhân viên", full_name: "Họ tên", email: "Email", job_title: "Chức danh" }.each do |key, label| %><div class="field"><%= f.label key, label %><%= f.text_field key, required: true %></div><% end %>
<div class="field"><%= f.label :department_id, "Phòng ban" %><%= f.collection_select :department_id, @departments, :id, :name %></div>
<div class="field"><%= f.label :hired_on, "Ngày vào làm" %><%= f.date_field :hired_on, required: true %></div>
<div class="field"><%= f.label :status, "Trạng thái" %><%= f.select :status, Employee.statuses.keys %></div>
<% if policy(@employee).sensitive? %><div class="field"><%= f.label :salary_cents, "Lương cơ bản (VND)" %><%= f.number_field :salary_cents, min: 0, required: true %></div><% end %>
<div class="field"><%= f.label :annual_leave_days, "Số ngày phép / năm" %><%= f.number_field :annual_leave_days, min: 0, step: 0.5 %></div>
<div class="field"><%= f.label :user_id, "Tài khoản liên kết" %><%= f.collection_select :user_id, @users, :id, :email, include_blank: "Chưa liên kết" %></div>
<% if policy(@employee).sensitive? %><div class="field"><%= f.label :bank_account, "Tài khoản ngân hàng (mã hóa)" %><%= f.text_field :bank_account %></div><% end %>
<% if policy(@employee).sensitive? %><div class="field"><%= f.label :national_id, "Giấy tờ định danh (mã hóa)" %><%= f.text_field :national_id %></div><% end %>
<%= f.hidden_field :lock_version %></div><div class="form-actions"><%= f.submit "Lưu hồ sơ" %><%= link_to "Quay lại", employees_path, class: "button secondary" %></div><% end %>
