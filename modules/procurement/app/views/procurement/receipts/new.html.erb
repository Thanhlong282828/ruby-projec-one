<div class="page-heading"><div><div class="eyebrow">MUA HÀNG / NHẬN HÀNG</div><h1>Ghi nhận hàng</h1><p><%= @record.code %> · <%= current_user.company.name %></p></div><%= link_to "← PO", purchase_order_path(@record) %></div>
<% if @errors %><div class="errors" role="alert"><%= @errors %></div><% end %>
<section class="panel"><p>Để trống hoặc nhập 0 ở dòng chưa nhận. Xác nhận sẽ lưu phiếu bất biến; chưa tạo tồn kho hoặc công nợ.</p>
<%= form_with url: goods_receipts_path, method: :post do %>
<%= hidden_field_tag "goods_receipt[purchase_order_id]", @record.id %><%= hidden_field_tag "goods_receipt[idempotency_key]", @input[:idempotency_key] %>
<div class="source-filters"><label for="received_on">Ngày nhận</label><%= date_field_tag "goods_receipt[received_on]", @input[:received_on], id: "received_on", required: true %><label for="delivery_reference">Mã chứng từ giao hàng (nếu có)</label><%= text_field_tag "goods_receipt[delivery_reference]", @input[:delivery_reference], id: "delivery_reference", maxlength: 200 %></div>
<div class="table-wrap"><table><thead><tr><th>Hàng / đơn vị</th><th>Đặt</th><th>Đã nhận</th><th>Còn lại</th><th>Nhận lần này</th></tr></thead><tbody><% @record.lines.each_with_index do |line, i| %><% received = @detail[:quantities].fetch(line.id, BigDecimal("0")); remaining = line.quantity - received %><tr><td><label for="receive_<%= line.id %>"><%= line.description %> (<%= line.unit %>)</label></td><td><%= line.quantity.to_s("F") %></td><td><%= received.to_s("F") %></td><td><%= remaining.to_s("F") %></td><td><%= hidden_field_tag "goods_receipt[items][#{i}][purchase_order_line_id]", line.id %><%= number_field_tag "goods_receipt[items][#{i}][quantity]", receipt_input_quantity(@input, line.id), id: "receive_#{line.id}", min: 0, max: remaining.to_s("F"), step: "0.001", disabled: remaining.zero?, inputmode: "decimal" %></td></tr><% end %></tbody></table></div>
<%= submit_tag "Xác nhận ghi nhận hàng" %><% end %></section>
