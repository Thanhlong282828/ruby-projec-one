<div class="page-heading"><div><div class="eyebrow">KHO / DANH MỤC</div><h1><%= @kind == :warehouse ? "Danh mục kho" : "Mã hàng" %></h1><p><%= current_user.company.name %> · <%= @workspace[:count] %> kết quả</p></div><% if policy(@kind == :warehouse ? Warehouse : StockItem).create? %><%= link_to "Tạo mới", inventory_catalog_url(@kind, action: :new), class: "button" %><% end %></div>
<%= form_with url: inventory_catalog_url(@kind), method: :get, class: "source-filters" do %><label for="q">Mã hoặc tên</label><%= search_field_tag :q, @workspace[:filters][:q], maxlength: 120 %><label for="status">Trạng thái</label><%= select_tag :status, options_for_select([["Tất cả", ""], ["Hoạt động", "active"], ["Ngừng hoạt động", "inactive"]], @workspace[:filters][:status]) %><%= submit_tag "Lọc" %><% end %>
<section class="panel"><table><thead><tr><th>Mã ổn định</th><th>Tên</th><% if @kind == :item %><th>Đơn vị</th><% end %><th>Trạng thái</th><th></th></tr></thead><tbody><% @workspace[:records].each do |row| %><tr><td><%= row.code %></td><td><%= row.name %></td><% if @kind == :item %><td><%= row.unit %></td><% end %><td><%= row.status == "active" ? "Hoạt động" : "Ngừng hoạt động" %></td><td><% if policy(row).update? %><%= link_to "Sửa", inventory_catalog_url(@kind, action: :edit, id: row.id) %><% end %></td></tr><% end %></tbody></table><% if @workspace[:records].empty? %><p class="empty">Chưa có danh mục phù hợp.</p><% end %></section>
<%= render "procurement/orders/pagination", workspace: @workspace, destination: @kind == :warehouse ? :inventory_warehouses_path : :inventory_items_path %>
