
<div class="page-heading">
    <div>
        <div class="eyebrow">
            ATTENDANCE
        </div>

        <h1>Thời gian làm việc.</h1>

        <p class="subtitle">
            Múi giờ: Asia/Ho_Chi_Minh • Mỗi ngày một ca.
        </p>
    </div>

    <%= link_to "Báo cáo theo kỳ →", attendance_report_path, class: "button" %>

    <% if @can_clock_in %>
        <%= button_to "◷ Vào ca hôm nay", attendances_path %>
    <% end %>
</div>

<%= form_with url: attendances_path, method: :get, class: "source-filters" do %><label for="status">Trạng thái</label><%= select_tag :status, options_for_select([["Tất cả", ""], ["Ca đang mở", "open"], ["Ca đã đóng", "closed"]], params[:status]) %><%= submit_tag "Lọc dữ liệu" %><%= link_to "Xóa bộ lọc", attendances_path %><% end %>
<div class="panel">
    <table>
        <thead>
            <tr>
                <th>Nhân viên</th>
                <th>Ngày</th>
                <th>Vào ca</th>
                <th>Ra ca</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            <% @attendances.each do |attendance| %>
                <tr>
                    <td>
                        <%= link_to attendance.employee.full_name, attendance_path(attendance) %>
                    </td>

                    <td>
                        <%= attendance.work_date %>
                    </td>

                    <td>
                        <%= attendance.checked_in_at.strftime("%H:%M") %>
                    </td>

                    <td>
                        <%= attendance.checked_out_at&.strftime("%H:%M") || "Đang làm việc" %>
                    </td>

                    <td>
                        <% if !attendance.checked_out_at && policy(attendance).checkout? %>
                            <%= button_to "Ra ca",
                                checkout_attendance_path(attendance),
                                method: :patch
                            %>
                        <% end %>
                    </td>
                </tr>
            <% end %>
        </tbody>
    </table>

    <% if @attendances.empty? %>
        <div class="empty">
            Chưa có dữ liệu chấm công.
        </div>
    <% end %>
</div>

<%= render "shared/pagination", records: @attendances %>
