#!/usr/bin/env ruby
# Scan publishable working-tree files, including untracked source. Never read local .env/keys.
require "fileutils"
require "json"
require "open3"
require "tmpdir"
require "securerandom"
Dir.chdir(File.expand_path("..", __dir__)) do
  root = Dir.pwd
  if ARGV.include?("--self-test")
    canary = "ghp_" + SecureRandom.alphanumeric(36)
    output, error, status = Open3.capture3("gitleaks", "stdin", "--redact=100", "--verbose", "--no-banner", "--no-color", "--config", File.join(root, ".gitleaks.toml"), stdin_data: "github_token=#{canary}")
    # rubocop:disable Rails/NegateInclude -- Standalone Ruby does not load ActiveSupport.
    abort "Secret scanner negative probe failed" unless status.exitstatus == 1 && (output + error).include?("REDACTED") && !(output + error).include?(canary)
    # rubocop:enable Rails/NegateInclude
    puts "Secret scanner rejected synthetic token and redacted its value."
  end
  files = if File.directory?(".git") || File.file?(".git")
    output, status = Open3.capture2("git", "ls-files", "--cached", "--others", "--exclude-standard", "-z")
    abort "Cannot enumerate publishable files" unless status.success?
    output.split("\0")
  else
    # Canonical Docker image intentionally has no .git; its build context is already filtered.
    Dir.glob("**/*", File::FNM_DOTMATCH)
  end
  # Ignored local secrets never enter this inventory. A force-added secret path must
  # fail on filename alone, before reading/staging its contents, rather than be skipped.
  private_path = %r{(?:\A|/)(?:\.env(?:\z|\.(?!example\z))|master\.key\z)|\Aconfig/credentials/.*\.key\z}
  exposed = files.select { |file| file.match?(private_path) }
  abort "Private configuration must not be publishable: #{exposed.join(', ')}" unless exposed.empty?
  forbidden = %r{\A(?:\.git(?:/|$)|\.env(?:\z|\.(?!example\z))|tmp/|log/|vendor/|coverage/|config/master\.key\z|config/credentials/.*\.key\z)}
  files.select! { |file| !file.match?(forbidden) && File.file?(file) }
  abort "Symlinks are not allowed in the secret scan snapshot" if files.any? { |file| File.symlink?(file) || !File.realpath(file).start_with?(root + "/") }
  Dir.mktmpdir("hrm-secret-scan-") do |directory|
    files.each do |file|
      target = File.join(directory, file)
      FileUtils.mkdir_p(File.dirname(target))
      FileUtils.copy_file(file, target)
    end
    puts "Secret scan: #{files.length} publishable source files; fully redacted output."
    report = File.join(Dir.tmpdir, "hrm-secret-report-#{Process.pid}.json")
    begin
      success = system("gitleaks", "dir", directory, "--redact=100", "--no-banner", "--no-color", "--config", File.join(root, ".gitleaks.toml"), "--report-format=json", "--report-path", report)
      unless success
        JSON.parse(File.read(report)).each do |finding|
          puts JSON.generate(finding.slice("RuleID", "File", "StartLine"))
        end
        abort "Secret scan failed (values redacted)"
      end
    ensure
      FileUtils.rm_f(report)
    end
  end
end
