<div class="page-heading"><div><div class="eyebrow">KHO</div><h1>Chờ nhập kho</h1><p><%= current_user.company.name %> · <%= @workspace[:count] %> phiếu nhận đã ghi nhận chưa có phiếu nhập</p></div><%= link_to "Lịch sử nhập", stock_receipts_path %></div>
<%= form_with url: pending_stock_receipts_path, method: :get, class: "source-filters" do %><label for="q">Mã phiếu nhận</label><%= search_field_tag :q, @workspace[:filters][:q], maxlength: 120 %><%= submit_tag "Tìm" %><% end %>
<section class="panel"><table><thead><tr><th>Phiếu nhận</th><th>PO</th><th>Ngày nhận</th><th></th></tr></thead><tbody><% @workspace[:records].each do |row| %><tr><td><%= link_to row.code, goods_receipt_path(row) %></td><td><%= row.purchase_order.code %></td><td><%= row.received_on %></td><td><%= link_to "Nhập kho", new_stock_receipt_path(goods_receipt_id: row.id) %></td></tr><% end %></tbody></table><% if @workspace[:records].empty? %><p class="empty">Không có phiếu nhận chờ nhập trong phạm vi của bạn.</p><% end %></section>
<%= render "procurement/orders/pagination", workspace: @workspace, destination: :pending_stock_receipts_path %>
