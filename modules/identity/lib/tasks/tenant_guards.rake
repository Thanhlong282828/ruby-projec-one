namespace :db do
  desc "Verify required membership and purchasing triggers without changing data"
  task verify_tenant_guards: :environment do
    names = ActiveRecord::Base.connection.select_values("SELECT TRIGGER_NAME FROM information_schema.TRIGGERS WHERE TRIGGER_SCHEMA=DATABASE()")
    required = %w[users_membership_insert_guard users_membership_update_guard procurement_request_insert_guard procurement_request_update_guard procurement_line_insert_guard procurement_line_update_guard procurement_line_delete_guard supplier_identity_guard purchase_order_insert_guard purchase_order_update_guard purchase_order_line_insert_guard purchase_order_line_update_guard purchase_order_line_delete_guard goods_receipt_insert_guard goods_receipt_update_guard goods_receipt_delete_guard goods_receipt_line_insert_guard goods_receipt_line_update_guard goods_receipt_line_delete_guard warehouses_identity_guard stock_items_identity_guard stock_receipt_insert_guard stock_receipt_update_guard stock_receipt_delete_guard stock_movement_insert_guard stock_movement_update_guard stock_movement_delete_guard stock_return_insert_guard stock_return_update_guard stock_return_delete_guard stock_return_line_insert_guard stock_return_line_update_guard stock_return_line_delete_guard]
    abort "Required database triggers missing; complete privileged migration first" unless (required - names).empty?
    puts "Required database guards: PASS"
  end
end
