<div class="page-heading"><div><div class="eyebrow">KHO</div><h1>Lịch sử nhập</h1><p><%= current_user.company.name %> · <%= @workspace[:count] %> phiếu đã ghi sổ</p></div><% if policy(StockReceipt).create? %><%= link_to "Chờ nhập kho", pending_stock_receipts_path %><% end %></div>
<%= form_with url: stock_receipts_path, method: :get, class: "source-filters" do %><label for="q">Mã phiếu nhập hoặc mã kho</label><%= search_field_tag :q, @workspace[:filters][:q], maxlength: 120 %><%= submit_tag "Tìm" %><% end %>
<section class="panel"><table><thead><tr><th>Phiếu nhập</th><th>Phiếu nhận</th><th>Kho tại lúc ghi</th><th>Ghi lúc</th></tr></thead><tbody><% @workspace[:records].each do |row| %><tr><td><%= link_to row.code, stock_receipt_path(row) %></td><td><%= row.goods_receipt.code %></td><td><%= row.warehouse_code_snapshot %> · <%= row.warehouse_name_snapshot %></td><td><%= row.posted_at.in_time_zone.strftime("%d/%m/%Y %H:%M") %></td></tr><% end %></tbody></table><% if @workspace[:records].empty? %><p class="empty">Chưa có phiếu nhập phù hợp.</p><% end %></section>
<%= render "procurement/orders/pagination", workspace: @workspace, destination: :stock_receipts_path %>
