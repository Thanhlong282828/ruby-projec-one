<div class="page-heading"><div><div class="eyebrow">NGHỈ PHÉP / #<%= @request.id %></div><h1>Đơn nghỉ phép</h1><p class="subtitle">Dữ liệu trong công ty đang làm việc.</p></div><%= link_to "← Danh sách", leave_requests_path(status: @request.status) %></div>
<section class="panel"><h2><%= @request.employee.full_name %></h2><p><%= @request.starts_on %> → <%= @request.ends_on %> · <%= @request.days %> ngày</p><p>Trạng thái: <%= t("erp.statuses.#{@request.status}") %></p><p><%= @request.reason %></p>
<% if @request.pending? && policy(@request).approve? %><div class="form-actions"><%= button_to "Duyệt", approve_leave_request_path(@request), method: :patch %><%= button_to "Từ chối", reject_leave_request_path(@request), method: :patch, class: "danger" %></div><% end %></section>
