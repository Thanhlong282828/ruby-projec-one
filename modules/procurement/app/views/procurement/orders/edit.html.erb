<h1>Sửa đơn mua hàng nháp</h1><p><%= @record.code %> · Số lượng/mô tả/nguồn giữ nguyên. Chỉ sửa đơn giá và ngày giao.</p>
<% if @errors %><div class="errors" role="alert"><%= @errors %></div><% end %>
<%= form_with url: purchase_order_path(@record, @list_filters), method: :patch, class: "panel field" do %><%= hidden_field_tag :lock_version, @record.lock_version %><label for="order_expected">Ngày giao dự kiến</label><%= date_field_tag "purchase_order[expected_on]", @input[:expected_on], id: "order_expected", required: true %>
<% @record.lines.each_with_index do |line, index| %><div class="panel"><p>Dòng <%= line.position %> · <%= line.description %> · <%= line.quantity.to_s("F") %> <%= line.unit %> · Giá nguồn <%= purchase_money(line.source_unit_price) %></p><%= hidden_field_tag "purchase_order[items][#{index}][source_line_id]", line.source_line_id %><label for="order_price_<%= index %>">Đơn giá đặt hàng dòng <%= line.position %> (VND)</label><%= number_field_tag "purchase_order[items][#{index}][unit_price]", order_input_price(@input, line), id: "order_price_#{index}", required: true, min: 0, max: "999999999999", step: 1 %></div><% end %>
<label for="order_price_reason">Lý do thay đổi giá (bắt buộc trước phát hành nếu có dòng đổi giá)</label><%= text_area_tag "purchase_order[price_change_reason]", @input[:price_change_reason], id: "order_price_reason", maxlength: 2000 %><div class="form-actions"><%= submit_tag "Lưu PO nháp" %><%= link_to "Quay lại PO", purchase_order_path(@record, @list_filters) %></div><% end %>
