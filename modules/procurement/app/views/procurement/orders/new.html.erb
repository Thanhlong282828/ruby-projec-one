<h1>Lập đơn mua hàng nháp</h1><p>Phiếu nguồn: <%= link_to @source[:record].code, purchase_request_path(@source[:record]) %> · <%= @source[:record].title %> · <%= purchase_money(@source[:record].estimated_total) %></p><p class="hint">Giữ nguyên số lượng và dòng hàng đã duyệt. Lưu nháp chưa phát hành PO hay tạo nhập kho/công nợ.</p>
<% if @errors %><div class="errors" role="alert"><%= @errors %></div><% end %>
<% if @source[:suppliers].empty? %><p class="empty">Chưa có nhà cung cấp hoạt động. Người có quyền cần bổ sung trước khi lập PO.</p><% else %>
<%= form_with url: purchase_orders_path, method: :post, class: "panel field" do %><%= hidden_field_tag "purchase_order[purchase_request_id]", @source[:record].id %><label for="order_supplier">Nhà cung cấp hoạt động</label><%= select_tag "purchase_order[supplier_id]", options_for_select(@source[:suppliers].map { |name, code, id| ["#{code} · #{name}", id] }, @input[:supplier_id]), id: "order_supplier", required: true %><label for="order_expected">Ngày giao dự kiến</label><%= date_field_tag "purchase_order[expected_on]", @input[:expected_on], id: "order_expected", required: true %><%= submit_tag "Tạo PO nháp" %><% end %><% end %>
