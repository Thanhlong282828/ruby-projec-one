<div class="page-heading"><div><div class="eyebrow">MUA HÀNG / NHẬN HÀNG</div><h1><%= @record.code %></h1><p>Đã ghi nhận · <%= current_user.company.name %> · nội dung giữ nguyên</p></div><%= link_to "← Phiếu nhận", goods_receipts_path %></div>
<section class="panel"><h2>Lịch sử ghi nhận</h2><p>Người nhận: Tài khoản #<%= @record.received_by_id %> · Ngày nhận: <%= @record.received_on %> · Ghi lúc: <%= @record.created_at.in_time_zone.strftime("%d/%m/%Y %H:%M:%S") %></p><% if @record.delivery_reference.present? %><p>Chứng từ giao hàng: <%= @record.delivery_reference %></p><% end %><% if @detail[:order_visible] %><p><%= link_to @record.purchase_order.code, purchase_order_path(@record.purchase_order_id) %></p><% end %><% if @detail[:source_visible] %><p><%= link_to "Yêu cầu mua gốc", purchase_request_path(@record.purchase_order.purchase_request_id) %></p><% end %>
<table><thead><tr><th>Dòng PO / hàng</th><th>Nhận lần này</th></tr></thead><tbody><% @record.lines.each do |line| %><tr><td>#<%= line.purchase_order_line_id %> · <%= line.purchase_order_line.description %></td><td><%= line.quantity.to_s("F") %> <%= line.purchase_order_line.unit %></td></tr><% end %></tbody></table></section>

<% if @detail[:stock_receipt] %><%= link_to "Xem phiếu nhập", stock_receipt_path(@detail[:stock_receipt]), class: "button" %><% elsif @detail[:can_post_stock] %><%= link_to "Nhập kho", new_stock_receipt_path(goods_receipt_id: @record.id), class: "button" %><% end %>
