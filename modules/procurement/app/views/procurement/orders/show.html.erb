<div class="page-heading"><div><div class="eyebrow">MUA HÀNG / PO</div><h1><%= @record.code %></h1><p><%= @record.title_snapshot %> · <%= @record.status == "draft" ? "Bản nháp" : "Đã phát hành" %> · Phiên bản <%= @record.lock_version %></p></div><%= link_to "← Danh sách PO đã lọc", purchase_orders_path(@list_filters) %></div>
<% if @errors %><div class="errors" role="alert"><%= @errors %></div><% end %>
<section class="panel"><h2>Thông tin đặt hàng</h2><p>Nhà cung cấp (snapshot): <%= @record.supplier_code_snapshot %> · <%= @record.supplier_name_snapshot %></p><p>Ngày giao dự kiến: <%= @record.expected_on %></p><p>Phiếu gốc: <% if @detail[:source_visible] %><%= link_to @record.request_code_snapshot, purchase_request_path(@record.purchase_request_id) %><% else %><%= @record.request_code_snapshot %><% end %></p>
<div class="stats"><div class="stat"><small>Dự toán đã duyệt</small><strong><%= purchase_money(@record.request_total_snapshot) %></strong></div><div class="stat"><small>Tổng đặt hàng</small><strong><%= purchase_money(@record.ordered_total) %></strong></div><div class="stat"><small>Chênh lệch (đặt hàng − dự toán)</small><strong><%= purchase_money(@record.ordered_total - @record.request_total_snapshot) %></strong></div></div>
<% if @record.price_change_reason.present? %><p class="purchase-purpose">Lý do thay đổi giá: <%= @record.price_change_reason %></p><% end %>
<table><thead><tr><th>Dòng / nguồn</th><th>Số lượng</th><th>Giá nguồn VND</th><th>Giá đặt VND</th><th>Thành tiền VND</th></tr></thead><tbody><% @record.lines.each do |line| %><tr><td><%= line.position %>. <%= line.description %><br><small>Dòng nguồn #<%= line.source_line_id %></small></td><td><%= line.quantity.to_s("F") %> <%= line.unit %></td><td><%= purchase_money(line.source_unit_price) %></td><td><%= purchase_money(line.unit_price) %></td><td><%= purchase_money(line.line_total) %></td></tr><% end %></tbody></table></section>
<% if policy(@record).update? %><%= link_to "Sửa PO nháp", edit_purchase_order_path(@record, @list_filters), class: "button secondary" %><% end %>
<% if policy(@record).issue? %><section class="panel"><h2>Kiểm tra trước khi phát hành</h2><p>Đối chiếu nhà cung cấp, ngày giao và chênh lệch giá. Phát hành sẽ khóa nội dung PO; chưa tự tạo nhập kho/hóa đơn/công nợ.</p><%= button_to "Xác nhận phát hành PO", issue_purchase_order_path(@record, @list_filters), method: :post, params: {lock_version: @record.lock_version} %></section><% end %>
<section class="panel" id="order-history"><h2>Lịch sử PO</h2><ol class="purchase-history"><% @detail[:events].each do |event| %><li><%= {"created" => "Tạo PO nháp", "updated" => "Sửa PO nháp", "issued" => "Phát hành PO"}.fetch(event.action) %> · Tài khoản #<%= event.actor_id %> · <%= event.created_at.in_time_zone.strftime("%d/%m/%Y %H:%M:%S") %> · Phiên bản <%= event.version %><% if event.note.present? %><p><%= event.note %></p><% end %></li><% end %></ol><div class="pagination"><% if @detail[:history_page] > 1 %><%= link_to "Lịch sử mới hơn", purchase_order_path(@record, @list_filters.merge(history_page: @detail[:history_page] - 1, anchor: "order-history")) %><% end %><% if @detail[:more_history] %><%= link_to "Lịch sử trước đó", purchase_order_path(@record, @list_filters.merge(history_page: @detail[:history_page] + 1, anchor: "order-history")) %><% end %></div></section>
