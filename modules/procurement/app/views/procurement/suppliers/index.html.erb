<div class="page-heading"><div><div class="eyebrow">MUA HÀNG</div><h1>Nhà cung cấp</h1><p><%= current_user.company.name %> · <%= @workspace[:count] %> nhà cung cấp</p></div><% if policy(ProcurementSupplier).create? %><%= link_to "+ Thêm nhà cung cấp", new_procurement_supplier_path, class: "button" %><% end %></div>
<%= form_with url: procurement_suppliers_path, method: :get, class: "source-filters" do %><label for="q">Mã hoặc tên</label><%= search_field_tag :q, @workspace[:filters][:q], maxlength: 120 %><label for="status">Trạng thái</label><%= select_tag :status, options_for_select([["Tất cả", ""], ["Hoạt động", "active"], ["Ngừng hoạt động", "inactive"]], @workspace[:filters][:status]) %><%= submit_tag "Lọc" %><% end %>
<section class="panel"><table><thead><tr><th>Mã</th><th>Tên</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><% @workspace[:records].each do |row| %><tr><td><%= row.code %></td><td><%= row.name %></td><td><%= row.status == "active" ? "Hoạt động" : "Ngừng hoạt động" %></td><td><% if policy(row).update? %><%= link_to "Sửa", edit_procurement_supplier_path(row) %><% end %></td></tr><% end %></tbody></table><% if @workspace[:records].empty? %><p class="empty">Không có nhà cung cấp phù hợp. <%= link_to "Xóa bộ lọc", procurement_suppliers_path %></p><% end %></section>
<%= render "procurement/orders/pagination", workspace: @workspace, destination: :procurement_suppliers_path %>
