  #   end
  #
  #   def each_iteration(csv_row)
  #     # insert csv_row into database
  #   end
  #
  # pkg:gem/sidekiq#lib/sidekiq/job/iterable/enumerators.rb:109
  def csv_enumerator(csv, cursor:); end
end

