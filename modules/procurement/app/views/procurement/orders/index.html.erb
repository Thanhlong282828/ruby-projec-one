<div class="page-heading"><div><div class="eyebrow">MUA HÀNG / PO</div><h1>Đơn mua hàng</h1><p><%= current_user.company.name %> · <%= @workspace[:count] %> PO phù hợp · VND</p></div><% if policy(PurchaseOrder).create? && policy(PurchaseRequest).index? %><%= link_to "Phiếu đã duyệt chờ lập PO", purchase_requests_path(status: "approved", view: "awaiting_po"), class: "button" %><% end %></div>
<%= form_with url: purchase_orders_path, method: :get, class: "source-filters" do %><label for="q">Mã PO hoặc tiêu đề</label><%= search_field_tag :q, @workspace[:filters][:q], maxlength: 120 %><label for="status">Trạng thái</label><%= select_tag :status, options_for_select([["Tất cả", ""], ["Bản nháp", "draft"], ["Đã phát hành", "issued"]], @workspace[:filters][:status]) %><label for="delivery">Tiến độ giao</label><%= select_tag :delivery, options_for_select([["Tất cả", ""], ["Còn chờ nhận", "pending"]], @workspace[:filters][:delivery]) %><%= submit_tag "Lọc PO" %><%= link_to "Xóa bộ lọc", purchase_orders_path %><% end %>
<section class="panel"><table><thead><tr><th>Mã / tiêu đề</th><th>Nhà cung cấp (snapshot)</th><th>Ngày giao</th><th>Tổng đặt hàng</th><th>Trạng thái</th><th></th></tr></thead><tbody><% @workspace[:records].each do |row| %><tr><td><%= row.code %><br><%= row.title_snapshot %></td><td><%= row.supplier_name_snapshot %></td><td><%= row.expected_on %><% if row.status == "issued" && row.expected_on < Date.current && @workspace[:progress][row.id] != "Đã nhận đủ" %><br><strong>Quá ngày giao</strong><% end %></td><td><%= purchase_money(row.ordered_total) %></td><td><%= row.status == "draft" ? "Bản nháp" : "Đã phát hành" %><br><%= @workspace[:progress][row.id] %></td><td><%= link_to "Chi tiết →", purchase_order_path(row, @workspace[:filters]) %></td></tr><% end %></tbody></table><% if @workspace[:records].empty? %><p class="empty">Không có PO trong quyền/công ty và bộ lọc hiện tại. <%= link_to "Xóa bộ lọc", purchase_orders_path %></p><% end %></section>
<%= render "pagination", workspace: @workspace, destination: :purchase_orders_path %>
