<div class="page-heading"><div><div class="eyebrow">PEOPLE DIRECTORY</div><h1>Đội ngũ của bạn.</h1><p class="subtitle">Mỗi hồ sơ là một phần của hành trình chung.</p></div><% if current_user.staff? %><%= link_to "+ Thêm nhân viên", new_employee_path, class: "button" %><% end %></div>
<div class="toolbar"><%= form_with url: employees_path, method: :get do |f| %><%= f.text_field :q, value: params[:q], placeholder: "Tên hoặc mã nhân viên…", aria: { label: "Tìm nhân viên" } %><%= f.submit "Tìm kiếm" %><% end %></div>
<div class="panel"><table><thead><tr><th>Mã</th><th>Nhân viên</th><th>Phòng ban</th><th>Chức danh</th><th>Trạng thái</th><th></th></tr></thead><tbody><% @employees.each do |employee| %><tr><td><%= employee.employee_code %></td><td><strong><%= employee.full_name %></strong><br><span class="muted"><%= employee.email %></span></td><td><%= employee.department.name %></td><td><%= employee.job_title %></td><td><span class="badge <%= employee.status %>"><%= employee.status %></span></td><td><%= link_to "Hồ sơ →", employee %></td></tr><% end %></tbody></table><% if @employees.empty? %><div class="empty">Chưa có nhân viên phù hợp.</div><% end %></div><%= render "shared/pagination", records: @employees %>
