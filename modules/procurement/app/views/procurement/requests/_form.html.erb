<% if @errors %><div class="errors" role="alert"><%= @errors %></div><% end %>
<%= form_with url: @record.persisted? ? purchase_request_path(@record, @list_filters) : purchase_requests_path(@list_filters), method: @record.persisted? ? :patch : :post do %>
<% if @record.persisted? %><%= hidden_field_tag :lock_version, @record.lock_version %><% end %>
<div class="panel"><div class="form-grid"><div class="field"><label for="purchase_title">Tiêu đề</label><%= text_field_tag "purchase_request[title]", @input[:title], id: "purchase_title", required: true, maxlength: 200 %></div><div class="field"><label for="purchase_needed">Ngày cần hàng</label><%= date_field_tag "purchase_request[needed_on]", @input[:needed_on], id: "purchase_needed", required: true %></div></div><div class="field"><label for="purchase_purpose">Mục đích mua</label><%= text_area_tag "purchase_request[purpose]", @input[:purpose], id: "purchase_purpose", required: true, maxlength: 4000 %></div></div>
<section class="panel" data-purchase-lines><h2>Dòng hàng dự kiến</h2><p class="hint">Từ 1 đến 50 dòng; bỏ qua dòng trống hoàn toàn. Số lượng tối đa 3 số lẻ, đơn giá nguyên đồng VND. Server làm tròn từng dòng 0,5 lên một đồng rồi cộng tổng khi lưu.</p><div data-purchase-line-list><% purchase_form_rows(@input).each_with_index do |item, index| %><%= render "line_fields", item: item, index: index %><% end %></div><template data-purchase-line-template><%= render "line_fields", item: {}, index: "__INDEX__" %></template><button type="button" class="secondary" data-add-purchase-line>+ Thêm dòng hàng</button><p class="hint" aria-live="polite" data-purchase-line-feedback></p></section>
<div class="form-actions"><%= submit_tag "Lưu phiếu nháp" %><%= link_to "Quay lại danh sách", purchase_requests_path(@list_filters), class: "button secondary" %></div>
<% end %>
