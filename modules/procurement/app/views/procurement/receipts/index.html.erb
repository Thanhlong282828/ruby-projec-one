<div class="page-heading"><div><div class="eyebrow">MUA HÀNG</div><h1>Nhận hàng</h1><p><%= current_user.company.name %> · <%= @workspace[:count] %> phiếu đã ghi</p></div><% if policy(PurchaseOrder).index? %><%= link_to "PO còn chờ nhận", purchase_orders_path(delivery: "pending"), class: "button" %><% end %></div>
<%= form_with url: goods_receipts_path, method: :get, class: "source-filters" do %><label for="q">Mã phiếu nhận</label><%= search_field_tag :q, @workspace[:filters][:q], maxlength: 120 %><%= submit_tag "Tìm phiếu" %><% end %>
<section class="panel"><table><thead><tr><th>Mã phiếu</th><th>Ngày nhận</th><th>Người nhận</th><th></th></tr></thead><tbody><% @workspace[:records].each do |row| %><tr><td><%= row.code %></td><td><%= row.received_on %></td><td>Tài khoản #<%= row.received_by_id %></td><td><%= link_to "Chi tiết →", goods_receipt_path(row) %></td></tr><% end %></tbody></table><% if @workspace[:records].empty? %><p class="empty">Chưa có phiếu nhận phù hợp.</p><% end %></section>
<%= render "procurement/orders/pagination", workspace: @workspace, destination: :goods_receipts_path %>
