RAILS_ENV=development
DATABASE_HOST=mysql
DATABASE_USERNAME=ruby
DATABASE_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
CABLE_REDIS_URL=redis://redis:6379/2
SECRET_KEY_BASE=CHANGE_ME
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace-with-32-random-characters
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace-with-32-random-characters
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace-with-32-random-characters
# Operator allowlist: target ID -> {url, company_ids} (443, no credentials/query). Empty disables outbound.
INTEGRATION_TARGETS_JSON={}
EVENT_URL=http://event_sink:8080/events
EVENT_SECRET=replace-with-random-secret
SMTP_HOST=mailpit
SMTP_PORT=1025
APP_HOST=localhost:3100
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password

# Optional trusted MySQL CA PEM path; local setup prepares its public CA in tmp.
# DATABASE_SSL_CA=/run/secrets/mysql-ca.pem
