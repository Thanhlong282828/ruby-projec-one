<div class="page-heading"><div><div class="eyebrow">MUA HÀNG / <%= @record.code %></div><h1><%= @record.title %></h1><p class="subtitle"><%= purchase_status_label(@record.status) %> · Người tạo #<%= @record.created_by_id %> · Phiên bản <%= @record.lock_version %></p></div><%= link_to "← Danh sách đã lọc", purchase_requests_path(@list_filters) %></div>
<% if @errors %><div class="errors" role="alert"><%= @errors %></div><% end %>
<section class="panel"><div class="panel-heading"><h2>Thông tin yêu cầu</h2><strong><%= purchase_money(@record.estimated_total) %></strong></div><p>Ngày cần hàng: <%= @record.needed_on %></p><p class="purchase-purpose"><%= @record.purpose %></p><p class="hint">Dự toán VND; không phải đơn mua hàng, nhập kho hoặc nghĩa vụ thanh toán.</p>
<% if @record.rejection_reason.present? %><p class="errors">Lý do từ chối: <%= @record.rejection_reason %></p><% end %>
<table><thead><tr><th>Dòng / mô tả</th><th>Số lượng</th><th>Đơn vị</th><th>Đơn giá VND</th><th>Thành tiền VND</th></tr></thead><tbody><% @record.lines.each do |line| %><tr><td><%= line.position %>. <%= line.description %></td><td><%= line.quantity.to_s("F") %></td><td><%= line.unit %></td><td><%= purchase_money(line.estimated_unit_price) %></td><td><%= purchase_money(line.line_total) %></td></tr><% end %></tbody></table></section>
<% if policy(@record).update? %><%= link_to "Sửa bản nháp", edit_purchase_request_path(@record, @list_filters), class: "button secondary" %><% end %>
<% if policy(@record).submit? %><section class="panel"><h2>Kiểm tra trước khi gửi duyệt</h2><p>Sau khi gửi, nội dung và dòng hàng được giữ nguyên. Người tạo không được tự duyệt.</p><%= button_to "Xác nhận gửi duyệt", submit_purchase_request_path(@record, @list_filters), method: :post, params: {lock_version: @record.lock_version} %></section><% end %>
<% if policy(@record).review? %><section class="panel"><h2>Quyết định yêu cầu</h2><p>Kiểm tra dự toán và dòng hàng trước khi quyết định.</p><%= form_with url: decide_purchase_request_path(@record, @list_filters), method: :post, class: "field" do %><%= hidden_field_tag :lock_version, @record.lock_version %><label for="purchase_reason">Lý do từ chối (bắt buộc khi từ chối)</label><%= text_area_tag :reason, params[:reason].is_a?(String) ? params[:reason] : nil, id: "purchase_reason", maxlength: 2000 %><div class="form-actions"><button type="submit" name="decision" value="approved">Xác nhận duyệt</button><button type="submit" name="decision" value="rejected" class="danger">Xác nhận từ chối</button></div><% end %></section><% end %>
<section class="panel" id="purchase-history"><h2>Lịch sử xử lý</h2><p class="hint">Mới nhất trước · tối đa 25 bước / trang · chỉ ghi khi transaction hoàn tất</p><ol class="purchase-history"><% @detail[:events].each do |event| %><li><strong><%= purchase_action_label(event.action) %></strong> · <%= event.actor_id == current_user.id ? "Bạn" : "Tài khoản ##{event.actor_id}" %> · <%= event.created_at.in_time_zone.strftime("%d/%m/%Y %H:%M:%S") %><br><small><%= event.from_status ? purchase_status_label(event.from_status) : "Bắt đầu" %> → <%= purchase_status_label(event.to_status) %> · Phiên bản <%= event.version %></small><% if event.note.present? %><p><%= event.note %></p><% end %></li><% end %></ol><div class="pagination"><% if @detail[:history_page] > 1 %><%= link_to "Lịch sử mới hơn", purchase_request_path(@record, @list_filters.merge(history_page: @detail[:history_page] - 1, anchor: "purchase-history")) %><% end %><% if @detail[:more_history] %><%= link_to "Lịch sử trước đó", purchase_request_path(@record, @list_filters.merge(history_page: @detail[:history_page] + 1, anchor: "purchase-history")) %><% end %></div></section>

<% if @detail[:order] %><section class="panel"><h2>Đơn mua hàng từ phiếu này</h2><%= link_to "Xem đơn mua hàng", purchase_order_path(@detail[:order]), class: "button" %></section><% elsif @detail[:can_create_order] %><section class="panel"><h2>Lập đơn mua hàng</h2><p>Mỗi phiếu đã duyệt chỉ tạo một PO. Thao tác này mở form, chưa tạo hay phát hành PO.</p><%= link_to "Tạo đơn mua hàng", new_purchase_order_path(purchase_request_id: @record.id), class: "button" %></section><% end %>
