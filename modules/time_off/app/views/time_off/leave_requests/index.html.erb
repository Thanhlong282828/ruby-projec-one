<div class="page-heading"><div><div class="eyebrow">TIME OFF</div><h1>Nghỉ ngơi để đi xa hơn.</h1><p class="subtitle">Theo dõi và phê duyệt đơn nghỉ phép.</p></div><% if current_user.allowed?("leave.submit") || current_user.allowed?("leave.submit_for_others") %><%= link_to "+ Tạo đơn", new_leave_request_path, class: "button" %><% end %></div><%= form_with url: leave_requests_path, method: :get, class: "source-filters" do %><label for="status">Trạng thái</label><%= select_tag :status, options_for_select([["Tất cả", ""], ["Chờ duyệt", "pending"], ["Đã duyệt", "approved"], ["Từ chối", "rejected"]], params[:status]) %><%= submit_tag "Lọc dữ liệu" %><%= link_to "Xóa bộ lọc", leave_requests_path %><% end %>
<div class="panel"><%= render "table", requests: @requests %></div><%= render "shared/pagination", records: @requests %>
