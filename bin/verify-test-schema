#!/usr/bin/env ruby
# Disposable DDL verification only: never loads or drops hrm_test/hrm_development.
require "open3"
require "securerandom"
require "digest"
abort "Run with RAILS_ENV=test" unless ENV["RAILS_ENV"] == "test"
name = "hrm_test_schema_#{SecureRandom.hex(6)}"
mysql = [ "docker", "compose", "exec", "-T", "mysql", "sh", "-c", 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysql --user=root --batch --skip-column-names' ]
run_sql = lambda do |sql|
  output, error, status = Open3.capture3(*mysql, stdin_data: sql)
  abort "Schema verification SQL failed: #{error}" unless status.success?
  output
end
begin
  run_sql.call("CREATE DATABASE `#{name}` CHARACTER SET utf8mb4;\nUSE `#{name}`;\n" + File.read(File.expand_path("../db/structure.sql", __dir__)))
  # rubocop:disable Rails/SquishedSQLHeredocs -- Several SQL statements sent to the standalone mysql client.
  inspection = <<~SQL
    SELECT CONSTRAINT_TYPE, COUNT(*) FROM information_schema.TABLE_CONSTRAINTS WHERE CONSTRAINT_SCHEMA='#{name}' GROUP BY CONSTRAINT_TYPE ORDER BY CONSTRAINT_TYPE;
    SELECT TRIGGER_NAME FROM information_schema.TRIGGERS WHERE TRIGGER_SCHEMA='#{name}' ORDER BY TRIGGER_NAME;
    SELECT COUNT(*) FROM information_schema.STATISTICS WHERE TABLE_SCHEMA='#{name}';
    SELECT COUNT(*) FROM `#{name}`.schema_migrations;
  SQL
  # rubocop:enable Rails/SquishedSQLHeredocs
  counts = run_sql.call(inspection)
  baseline = run_sql.call(inspection.gsub(name, "hrm_test"))
  abort "Fresh schema constraints/indexes/migration versions differ from hrm_test" unless counts == baseline
  # Compare real definitions too: equal counts alone cannot prove a FK/index is correct.
  # rubocop:disable Rails/SquishedSQLHeredocs -- Multiple standalone mysql statements.
  definitions = <<~SQL
    SELECT TABLE_NAME,COLUMN_NAME,COLUMN_TYPE,IS_NULLABLE,COLUMN_DEFAULT,COLLATION_NAME FROM information_schema.COLUMNS WHERE TABLE_SCHEMA='#{name}' ORDER BY TABLE_NAME,ORDINAL_POSITION;
    SELECT TABLE_NAME,INDEX_NAME,NON_UNIQUE,SEQ_IN_INDEX,COLUMN_NAME,SUB_PART FROM information_schema.STATISTICS WHERE TABLE_SCHEMA='#{name}' ORDER BY TABLE_NAME,INDEX_NAME,SEQ_IN_INDEX;
    SELECT TABLE_NAME,COLUMN_NAME,REFERENCED_TABLE_NAME,REFERENCED_COLUMN_NAME FROM information_schema.KEY_COLUMN_USAGE WHERE CONSTRAINT_SCHEMA='#{name}' ORDER BY TABLE_NAME,CONSTRAINT_NAME,ORDINAL_POSITION;
    SELECT CONSTRAINT_NAME,TABLE_NAME,REFERENCED_TABLE_NAME,UPDATE_RULE,DELETE_RULE FROM information_schema.REFERENTIAL_CONSTRAINTS WHERE CONSTRAINT_SCHEMA='#{name}' ORDER BY TABLE_NAME,CONSTRAINT_NAME;
    SELECT CONSTRAINT_NAME,CHECK_CLAUSE FROM information_schema.CHECK_CONSTRAINTS WHERE CONSTRAINT_SCHEMA='#{name}' ORDER BY CONSTRAINT_NAME;
    SELECT TRIGGER_NAME,ACTION_TIMING,EVENT_MANIPULATION,ACTION_STATEMENT FROM information_schema.TRIGGERS WHERE TRIGGER_SCHEMA='#{name}' ORDER BY TRIGGER_NAME;
    SELECT version FROM `#{name}`.schema_migrations ORDER BY version;
  SQL
  # rubocop:enable Rails/SquishedSQLHeredocs
  actual = run_sql.call(definitions)
  expected = run_sql.call(definitions.gsub(name, "hrm_test"))
  abort "Fresh schema definitions differ from hrm_test" unless actual == expected
  puts "Schema definition SHA256: #{Digest::SHA256.hexdigest(actual)}"

  abort "Fresh schema lost membership guards" unless %w[users_membership_insert_guard users_membership_update_guard procurement_request_insert_guard procurement_request_update_guard procurement_line_insert_guard procurement_line_update_guard procurement_line_delete_guard supplier_identity_guard purchase_order_insert_guard purchase_order_update_guard purchase_order_line_insert_guard purchase_order_line_update_guard purchase_order_line_delete_guard goods_receipt_insert_guard goods_receipt_update_guard goods_receipt_delete_guard goods_receipt_line_insert_guard goods_receipt_line_update_guard goods_receipt_line_delete_guard warehouses_identity_guard stock_items_identity_guard stock_receipt_insert_guard stock_receipt_update_guard stock_receipt_delete_guard stock_movement_insert_guard stock_movement_update_guard stock_movement_delete_guard stock_return_insert_guard stock_return_update_guard stock_return_delete_guard stock_return_line_insert_guard stock_return_line_update_guard stock_return_line_delete_guard return_reversal_insert_guard return_reversal_update_guard return_reversal_delete_guard return_reversal_line_insert_guard return_reversal_line_update_guard return_reversal_line_delete_guard].all? { |guard| counts.include?(guard) }
  puts "Fresh structure.sql loaded into disposable MySQL test schema #{name}."
  puts counts
ensure
  run_sql.call("DROP DATABASE IF EXISTS `#{name}`;")
end
