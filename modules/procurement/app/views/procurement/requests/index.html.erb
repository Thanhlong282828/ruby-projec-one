<div class="page-heading"><div><div class="eyebrow">MUA HÀNG / YÊU CẦU MUA</div><h1><%= purchase_queue_title(@list_filters[:view]) %></h1><p class="subtitle"><%= current_user.company.name %> · <%= @workspace[:count] %> phiếu phù hợp · VND · 25 phiếu / trang</p></div><% if policy(PurchaseRequest).create? %><%= link_to "+ Tạo phiếu nháp", new_purchase_request_path(@list_filters), class: "button" %><% end %></div>
<nav class="integration-tabs" aria-label="Hàng đợi mua hàng"><%= link_to "Tất cả được xem", purchase_requests_path, class: "button secondary" %><%= link_to "Yêu cầu của tôi", purchase_requests_path(view: "mine"), class: "button secondary" %><% if policy(PurchaseRequest).review_queue? %><%= link_to "Chờ tôi duyệt", purchase_requests_path(view: "review", status: "submitted"), class: "button secondary" %><% end %></nav>
<%= form_with url: purchase_requests_path, method: :get, class: "source-filters" do %><%= hidden_field_tag :view, params[:view] %><label for="q">Mã hoặc tiêu đề</label><%= search_field_tag :q, params[:q], maxlength: 120 %><label for="status">Trạng thái</label><%= select_tag :status, options_for_select(purchase_status_options(@list_filters[:view]), params[:status]) %><%= submit_tag "Lọc phiếu" %><%= link_to "Xóa bộ lọc", purchase_requests_path %><% end %>
<div class="panel"><table><thead><tr><th>Mã / tiêu đề</th><th>Ngày cần hàng</th><th>Tổng dự kiến</th><th>Trạng thái</th><th></th></tr></thead><tbody><% @workspace[:records].each do |record| %><tr><td><strong><%= record.code %></strong><br><%= record.title %></td><td><%= record.needed_on %></td><td><%= purchase_money(record.estimated_total) %></td><td><span class="badge <%= record.status %>"><%= purchase_status_label(record.status) %></span></td><td><%= link_to "Chi tiết →", purchase_request_path(record, @list_filters) %></td></tr><% end %></tbody></table>
<% if @workspace[:records].empty? %><div class="empty"><p>Không có phiếu trong phạm vi quyền và bộ lọc đang áp dụng.</p><p>Tìm: <%= @list_filters[:q].presence || "không giới hạn" %> · Trạng thái: <%= @list_filters[:status] ? purchase_status_label(@list_filters[:status]) : "tất cả" %> · Phạm vi: <%= @list_filters[:view] == "awaiting_po" ? "đã duyệt, chưa có PO" : @list_filters[:view] == "review" ? "chờ tôi duyệt, không gồm phiếu tự tạo" : @list_filters[:view] == "mine" ? "của tôi" : "được cấp quyền" %></p><%= link_to "Xóa bộ lọc", purchase_requests_path %></div><% end %></div>
<%= render "shared/pagination", records: @workspace[:records] %>
