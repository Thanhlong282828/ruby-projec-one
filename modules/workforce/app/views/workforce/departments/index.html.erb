<div class="page-heading"><div><div class="eyebrow">ORGANIZATION</div><h1>Cơ cấu tổ chức.</h1></div><% if policy(Department).create? %><%= link_to "+ Thêm phòng ban", new_department_path, class: "button" %><% end %></div>
<div class="panel"><table><thead><tr><th>Mã</th><th>Tên phòng ban</th><th></th></tr></thead><tbody><% @departments.each do |department| %><tr><td><%= department.code %></td><td><%= department.name %></td><td><% if policy(department).update? %><%= link_to "Chỉnh sửa", edit_department_path(department) %><% end %> <% if policy(department).destroy? %><%= button_to "Xóa", department, method: :delete, class: "danger" %><% end %></td></tr><% end %></tbody></table></div><%= render "shared/pagination", records: @departments %>
