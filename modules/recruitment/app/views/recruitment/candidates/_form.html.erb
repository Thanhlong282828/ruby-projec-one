<%= render "shared/errors", record: @candidate %><%= form_with model: @candidate do |f| %><div class="form-grid"><% { full_name: "Họ tên", email: "Email", position: "Vị trí ứng tuyển" }.each do |key, label| %><div class="field"><%= f.label key, label %><%= f.text_field key, required: true %></div><% end %><div class="field"><%= f.label :stage, "Giai đoạn" %><%= f.select :stage, Candidate.stages.keys %></div><div class="field"><%= f.label :notes, "Ghi chú" %><%= f.text_area :notes %></div></div><div class="form-actions"><%= f.submit "Lưu ứng viên" %></div><% end %>
