<% company = @workspace[:company] %>
<div class="page-heading"><div><div class="eyebrow">SYSTEM / COMPANY</div><h1><%= company.name %></h1><p class="subtitle"><%= company.code %> · #<%= company.id %></p></div><%= link_to "← Danh mục công ty", "/system/companies", class: "button secondary" %></div>
<div class="panel"><p><%= link_to "Chọn membership để làm việc tại công ty →", "/my/companies" %></p><p>Quản trị tổng xem danh mục và cấp membership; dữ liệu nhân sự/lương vẫn cần chuyển vào công ty với quyền phù hợp.</p>
<% if SystemCompanyPolicy.new(current_user, Company).update? %><%= form_with url: "/system/companies/#{company.id}", method: :patch, scope: :company do |f| %><%= hidden_field_tag :lock_version, company.lock_version %><div class="form-grid"><div class="field"><%= f.label :name, "Tên công ty" %><%= f.text_field :name, value: company.name, required: true %></div><div class="field"><%= f.label :active, "Trạng thái" %><%= f.select :active, [["Hoạt động","true"],["Tạm khóa","false"]], selected: company.active?.to_s %></div></div><%= f.submit "Lưu công ty", class: "button" %><% end %><% end %></div>
<div class="panel" id="branches"><h2>Chi nhánh thuộc công ty (tối đa 100)</h2><% if @workspace[:branches].empty? %><p class="empty">Chưa có chi nhánh.</p><% else %><table><thead><tr><th>Mã</th><th>Tên chi nhánh</th></tr></thead><tbody><% @workspace[:branches].each do |id,code,name| %><tr><td><%= code %></td><td><%= name %></td></tr><% end %></tbody></table><% end %><% if company.id == current_user.company_id %><%= link_to "Quản lý chi nhánh công ty hiện tại →", "/organization/branches" %><% else %><p class="hint">Chuyển công ty bằng membership trước khi tạo/sửa chi nhánh.</p><% end %></div>
<div class="panel"><h2>Membership tại công ty (tối đa 100)</h2><table><thead><tr><th>Profile ID / email</th><th>Vai trò</th><th>Định danh gốc</th><th>Trạng thái</th></tr></thead><tbody><% @workspace[:memberships].each do |id,email,role,active,principal| %><tr><td>#<%= id %> · <%= email %></td><td><%= role %></td><td>#<%= principal || id %></td><td><%= active ? "Hoạt động" : "Tạm khóa" %></td></tr><% end %></tbody></table>
<% if SystemCompanyPolicy.new(current_user, Company).create? %><h3>Cấp quyền vào công ty cho định danh có sẵn</h3><%= form_with url: "/system/companies/#{company.id}/memberships" do |f| %><div class="form-grid"><div class="field"><%= f.label :principal_id, "ID định danh đăng nhập gốc" %><%= f.number_field :principal_id, min: 1, required: true %></div><div class="field"><%= f.label :role, "Vai trò riêng tại công ty này" %><%= f.select :role, @workspace[:roles] %></div></div><%= f.submit "Cấp membership", class: "button" %><% end %><p class="hint">Định danh của bạn: #<%= current_user.identity_id %>. Membership có sẵn được chỉnh/thu hồi bằng Tài khoản & quyền tại công ty đích.</p><% end %></div>
<div class="panel"><h2>Nhật ký quản trị tổng gần nhất</h2><% @workspace[:audits].each do |log| %><p><%= log.created_at %> · <%= log.action %> · <%= log.record_type %>#<%= log.record_id %> · Định danh #<%= log.principal_user_id %></p><% end %></div>
