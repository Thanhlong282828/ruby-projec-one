<div class="page-heading"><div><div class="eyebrow">KHO / SỔ BIẾN ĐỘNG</div><h1>Tồn theo kho</h1><p><%= current_user.company.name %> · nhập trừ trả nhà cung cấp đã ghi sổ · <%= @workspace[:count] %> cặp kho/mã hàng</p></div></div>
<%= form_with url: stock_balances_path, method: :get, class: "source-filters" do %><label for="warehouse_id">Kho</label><%= select_tag :warehouse_id, options_for_select(@workspace[:warehouses].map { |name, code, id, status| ["#{code} · #{name}#{status == 'inactive' ? ' (ngừng hoạt động)' : ''}", id] }, @workspace[:filters][:warehouse_id]), prompt: "Tất cả kho trong quyền của bạn" %><%= submit_tag "Xem tồn" %><% end %>
<section class="panel"><table><thead><tr><th>Kho</th><th>Mã hàng ổn định</th><th>Tồn</th><th>Đơn vị</th></tr></thead><tbody><% @workspace[:records].each do |row| %><tr><td><%= row[:warehouse].code %> · <%= row[:warehouse].name %><% if row[:warehouse].status == "inactive" %> (ngừng hoạt động)<% end %></td><td><%= row[:item].code %> · <%= row[:item].name %><% if row[:item].status == "inactive" %> (ngừng hoạt động)<% end %></td><td><%= link_to row[:quantity].to_s("F"), stock_ledger_path(warehouse_id: row[:warehouse].id, stock_item_id: row[:item].id), aria: { label: "Xem biến động #{row[:item].code} tại kho #{row[:warehouse].code}" } %></td><td><%= row[:item].unit %></td></tr><% end %></tbody></table><% if @workspace[:records].empty? %><p class="empty">Chưa có biến động đã ghi sổ trong phạm vi và bộ lọc này.</p><% end %></section>
<%= render "procurement/orders/pagination", workspace: @workspace, destination: :stock_balances_path %>
