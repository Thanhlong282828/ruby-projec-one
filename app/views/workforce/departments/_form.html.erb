<%= render "shared/errors", record: @department %><%= form_with model: @department do |f| %><div class="form-grid"><div class="field"><%= f.label :name, "Tên phòng ban" %><%= f.text_field :name, required: true %></div><div class="field"><%= f.label :code, "Mã phòng ban (viết hoa)" %><%= f.text_field :code, required: true %></div></div><div class="form-actions"><%= f.submit "Lưu phòng ban" %></div><% end %>
