<%= render "integration/shared/navigation" %>
<% source = @workspace[:source] %>
<div class="page-heading"><div><div class="eyebrow">INTEGRATION / PAYROLL SNAPSHOT</div><h1>Thông báo snapshot bảng lương</h1><p class="subtitle">Kỳ <%= source.period.strftime("%m/%Y") %> · <%= source.public_id %></p></div><%= link_to "Mở snapshot nguồn →", "/payroll/exports/#{source.id}", class: "button secondary" %></div>
<div class="panel"><h2>Nội dung chia sẻ</h2><p>Chỉ gửi mã snapshot, kỳ, định dạng, phiên bản, kích thước và checksum tới đích công ty cho phép. Không gửi CSV, mức lương, danh sách nhân viên hoặc liên kết tải.</p><p class="hint">Worker kiểm lại quyền và toàn vẹn nguồn trước khi gửi. Một thông báo cho mỗi snapshot/kết nối/đích; bấm lại không tạo trùng.</p>
<% if @workspace[:targets].empty? || @workspace[:connections].empty? %><p class="empty">Chưa có kết nối đang bật và đích HTTPS được cấu hình cho công ty. Chưa thể gửi ra ngoài.</p><% else %>
<%= form_with url: "/integration/payroll-exports/#{source.id}" do |form| %><div class="form-grid"><div class="field"><%= form.label :connection_id, "Kết nối" %><%= form.select :connection_id, @workspace[:connections].map { |c| [c.name, c.id] } %></div><div class="field"><%= form.label :target_key, "Đích được phép" %><%= form.select :target_key, @workspace[:targets] %></div></div><%= form.submit "Xếp hàng thông báo", class: "button" %><% end %><% end %></div>
<div class="panel"><h2>25 thông báo gần nhất từ snapshot này</h2><% if @workspace[:deliveries].empty? %><p class="empty">Chưa có thông báo.</p><% else %><table><thead><tr><th>Event ID</th><th>Đích</th><th>Trạng thái</th><th></th></tr></thead><tbody><% @workspace[:deliveries].each do |record| %><tr><td><%= record.event_id %></td><td><%= record.target_key %></td><td><%= record.status %></td><td><%= link_to "Chi tiết →", "/integration/outbound/#{record.id}" %></td></tr><% end %></tbody></table><% end %></div>
