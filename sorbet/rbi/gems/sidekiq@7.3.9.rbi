  def active_record_relations_enumerator(relation, cursor:, **options); end

  # Builds Enumerator object from a given array, using +cursor+ as an offset.
  #
  # @param array [Array]
  # @param cursor [Integer] offset to start iteration from
  #
  # @return [Enumerator]
