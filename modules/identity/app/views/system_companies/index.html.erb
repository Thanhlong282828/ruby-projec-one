<div class="page-heading"><div><div class="eyebrow">SYSTEM / MULTI-COMPANY</div><h1>Công ty toàn hệ thống</h1><p class="subtitle">Một hệ thống · Nhiều công ty · Mỗi công ty nhiều chi nhánh</p></div><%= link_to "Công ty của tôi →", "/my/companies", class: "button secondary" %></div>
<div class="stats"><%= link_to "/system/companies", class: "stat metric-card" do %><small>Tất cả công ty trong hệ thống</small><strong><%= @workspace[:total] %></strong><span>Mở danh mục nguồn ↗</span><% end %></div>
<div class="panel"><h2>Danh mục công ty</h2><table><thead><tr><th>Công ty</th><th>Chi nhánh</th><th>Trạng thái</th><th></th></tr></thead><tbody><% @workspace[:companies].each do |company| %><tr><td><strong><%= company.name %></strong><br><small><%= company.code %></small></td><td><%= link_to @workspace[:branches].fetch(company.id,0), "/system/companies/#{company.id}#branches" %></td><td><%= company.active? ? "Hoạt động" : "Tạm khóa" %></td><td><%= link_to "Quản lý →", "/system/companies/#{company.id}" %></td></tr><% end %></tbody></table><% if @workspace[:next_before] %><%= link_to "Công ty cũ hơn →", "/system/companies?before=#{@workspace[:next_before]}" %><% end %></div>
<% if SystemCompanyPolicy.new(current_user, Company).create? %><div class="panel"><h2>Tạo công ty</h2><%= form_with url: "/system/companies", scope: :company do |f| %><div class="form-grid"><div class="field"><%= f.label :code, "Mã công ty (A-Z, 0-9, _, -)" %><%= f.text_field :code, required: true, maxlength: 30 %></div><div class="field"><%= f.label :name, "Tên công ty" %><%= f.text_field :name, required: true, maxlength: 255 %></div></div><%= f.submit "Tạo công ty", class: "button" %><% end %><p class="hint">Tạo bộ vai trò riêng và cấp membership admin cho định danh của bạn. Không copy dữ liệu hoặc mật khẩu.</p></div><% end %>
