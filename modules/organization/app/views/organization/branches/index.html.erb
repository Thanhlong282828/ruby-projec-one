<div class="page-heading"><div><div class="eyebrow">ORGANIZATION / BRANCHES</div><h1>Chi nhánh công ty</h1><p class="subtitle"><%= current_user.company.name %> · Dữ liệu theo công ty đang chọn</p></div><%= link_to "Cây tổ chức →", "/organization/tree", class: "button secondary" %></div>
<div class="stats"><%= link_to "/organization/branches", class: "stat metric-card" do %><small>Tổng chi nhánh thuộc công ty hiện tại</small><strong><%= @workspace[:total] %></strong><span>Mở danh sách nguồn ↗</span><% end %></div>
<div class="panel"><h2>Danh sách chi nhánh</h2>
<%= form_with url: "/organization/branches", method: :get, class: "branch-filter-form" do |f| %>
  <div class="field"><%= f.label :q, "Tìm mã hoặc tên chi nhánh" %><%= f.search_field :q, value: @workspace[:q], maxlength: 100, placeholder: "Ví dụ: Hà Nội" %></div>
  <div class="field"><%= f.label :status, "Hiệu lực chi nhánh" %><%= f.select :status, [["Tất cả", "all"], ["Đang hiệu lực", "current"], ["Sắp hoạt động", "upcoming"], ["Đã kết thúc", "ended"]], selected: @workspace[:status] %></div>
  <%= f.submit "Lọc chi nhánh", class: "button" %><%= link_to "Xóa bộ lọc", "/organization/branches", class: "text-button" %>
<% end %>
<p class="hint"><%= @workspace[:matching] %> chi nhánh khớp bộ lọc · Hiển thị tối đa 25 dòng mỗi trang · Hiệu lực tính theo ngày <%= Date.current %>.</p><% if @workspace[:records].empty? %><p class="empty">Không có chi nhánh khớp bộ lọc. Bạn có thể xóa bộ lọc hoặc tạo chi nhánh khi có quyền.</p><% else %><table><thead><tr><th>Mã</th><th>Tên chi nhánh</th><th>Hiệu lực</th><th></th></tr></thead><tbody><% @workspace[:records].each do |r| %><tr><td><%= r.code %></td><td><%= r.name %></td><td><%= r.effective_from %> → <%= r.effective_to || "Không giới hạn" %></td><td><%= link_to "Chi tiết / chỉnh sửa →", "/organization/organization-units/#{r.id}" %></td></tr><% end %></tbody></table><% end %>
<div class="pagination"><% if params[:after].present? %><%= link_to "← Trang đầu", {q: @workspace[:q], status: @workspace[:status]} %><% end %><% if @workspace[:next_after] %><%= link_to "Trang tiếp →", {q: @workspace[:q], status: @workspace[:status], after: @workspace[:next_after]} %><% end %></div></div>
<% if policy(OrganizationUnit).create? %><div class="panel"><h2>Tạo chi nhánh</h2><%= form_with url: "/organization/branches", scope: :branch do |f| %><div class="form-grid"><div class="field"><%= f.label :code, "Mã chi nhánh" %><%= f.text_field :code, required: true, maxlength: 30 %></div><div class="field"><%= f.label :name, "Tên chi nhánh" %><%= f.text_field :name, required: true, maxlength: 255 %></div><div class="field"><%= f.label :parent_id, "Đơn vị công ty trong cây tổ chức (nếu có)" %><%= f.select :parent_id, @workspace[:parents], include_blank: "Trực thuộc công ty hiện tại" %></div><div class="field"><%= f.label :effective_from, "Hiệu lực từ" %><%= f.date_field :effective_from, value: Date.current, required: true %></div><div class="field"><%= f.label :headcount_limit, "Giới hạn nhân sự" %><%= f.number_field :headcount_limit, value: 0, min: 0, required: true %></div></div><%= f.submit "Tạo chi nhánh", class: "button" %><% end %><p class="hint">Chi nhánh là đơn vị thật trong cây tổ chức; có thể gắn vị trí và phân công nhân sự. Quyền hiện tại áp dụng toàn công ty, chưa giới hạn tài khoản theo từng chi nhánh.</p></div><% end %>
